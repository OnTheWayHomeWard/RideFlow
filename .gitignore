# ── Secrets / env ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ── Node / Vite ──
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker / DB dumps ──
postgres_data/
*.sql.gz
*.dump

# ── OS ──
.DS_Store
Thumbs.db

# ── Editors / IDEs ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Claude Code working files ──
.claude/

# firebase-service-account.json is intentionally NOT in .gitignore — this is
# a private repo and the FCM service account is tracked so deploys are
# self-contained. If repo visibility ever changes, restore this exclusion
# AND rotate the key in Firebase Console -> Service accounts immediately.
